{
  "__inputs": [
    {
      "name": "DS_GRAFANACLOUD_METRICS",
      "label": "Grafana Cloud Metrics",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": "${DS_GRAFANACLOUD_METRICS}",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (platform_observability_runtime_mode) (rate(http_server_request_count_total{deployment_environment=~\"$environment\",service_name=~\"$service\"}[5m]))",
          "legendFormat": "{{platform_observability_runtime_mode}}",
          "refId": "A"
        }
      ],
      "title": "Request Rate by Runtime Mode",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_GRAFANACLOUD_METRICS}",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "count by (platform_observability_runtime_mode, platform_observability_telemetry_profile) (http_server_request_count_total{deployment_environment=~\"$environment\",service_name=~\"$service\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "{{platform_observability_runtime_mode}} / {{platform_observability_telemetry_profile}}",
          "refId": "A"
        }
      ],
      "title": "Observed Mode/Profile Combinations",
      "type": "table"
    },
    {
      "datasource": "${DS_GRAFANACLOUD_METRICS}",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, platform_observability_runtime_mode) (rate(http_server_request_duration_seconds_bucket{deployment_environment=~\"$environment\",service_name=~\"$service\"}[5m])))",
          "legendFormat": "{{platform_observability_runtime_mode}}",
          "refId": "A"
        }
      ],
      "title": "P95 Latency by Runtime Mode",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_GRAFANACLOUD_METRICS}",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (platform_observability_runtime_mode) (rate(http_server_request_count_total{deployment_environment=~\"$environment\",service_name=~\"$service\",http_response_status_class=~\"4xx|5xx\"}[5m])) / clamp_min(sum by (platform_observability_runtime_mode) (rate(http_server_request_count_total{deployment_environment=~\"$environment\",service_name=~\"$service\"}[5m])), 0.0001)",
          "legendFormat": "{{platform_observability_runtime_mode}}",
          "refId": "A"
        }
      ],
      "title": "Error Ratio by Runtime Mode",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_GRAFANACLOUD_METRICS}",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "mode": "markdown",
      "options": {
        "content": "This dashboard is Phase 3 runtime-path visibility. It assumes request metrics carry translated resource labels for `platform.observability.runtime_mode` and `platform.observability.telemetry_profile`. During Phase 3 that means the dashboard proves the shared query contract is portable across direct OTLP and collector-gateway paths; final authoritative provisioning moves to Phase 5 Terraform.",
        "mode": "markdown"
      },
      "title": "Contract Notes",
      "type": "text"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": [
    "phase-3",
    "p3-t06",
    "grafana-cloud",
    "runtime-mode"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": [
            "$__all"
          ]
        },
        "datasource": "${DS_GRAFANACLOUD_METRICS}",
        "definition": "label_values(http_server_request_count_total, deployment_environment)",
        "includeAll": true,
        "label": "Environment",
        "multi": true,
        "name": "environment",
        "options": [],
        "query": {
          "query": "label_values(http_server_request_count_total, deployment_environment)",
          "refId": "PrometheusVariableQueryEditor-Environment"
        },
        "refresh": 1,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "backend-api",
          "value": [
            "backend-api"
          ]
        },
        "datasource": "${DS_GRAFANACLOUD_METRICS}",
        "definition": "label_values(http_server_request_count_total{deployment_environment=~\"$environment\"}, service_name)",
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "options": [],
        "query": {
          "query": "label_values(http_server_request_count_total{deployment_environment=~\"$environment\"}, service_name)",
          "refId": "PrometheusVariableQueryEditor-Service"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Runtime Path Status",
  "uid": "bp-runtime-path-status",
  "version": 1,
  "weekStart": ""
}
