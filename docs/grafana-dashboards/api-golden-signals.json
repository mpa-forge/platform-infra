{
  "__inputs": [
    {
      "name": "DS_GRAFANACLOUD_METRICS",
      "label": "Grafana Cloud Metrics",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": "${DS_GRAFANACLOUD_METRICS}",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_count_total{deployment_environment=~\"$environment\",service_name=~\"$service\",platform_observability_runtime_mode=~\"$runtime_mode\",platform_observability_telemetry_profile=~\"$telemetry_profile\"}[5m]))",
          "legendFormat": "requests/sec",
          "refId": "A"
        }
      ],
      "title": "Request Throughput",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_GRAFANACLOUD_METRICS}",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.02
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_count_total{deployment_environment=~\"$environment\",service_name=~\"$service\",platform_observability_runtime_mode=~\"$runtime_mode\",platform_observability_telemetry_profile=~\"$telemetry_profile\",http_response_status_class=~\"4xx|5xx\"}[5m])) / clamp_min(sum(rate(http_server_request_count_total{deployment_environment=~\"$environment\",service_name=~\"$service\",platform_observability_runtime_mode=~\"$runtime_mode\",platform_observability_telemetry_profile=~\"$telemetry_profile\"}[5m])), 0.0001)",
          "legendFormat": "error ratio",
          "refId": "A"
        }
      ],
      "title": "Error Ratio",
      "type": "stat"
    },
    {
      "datasource": "${DS_GRAFANACLOUD_METRICS}",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{deployment_environment=~\"$environment\",service_name=~\"$service\",platform_observability_runtime_mode=~\"$runtime_mode\",platform_observability_telemetry_profile=~\"$telemetry_profile\"}[5m])))",
          "legendFormat": "p95 latency",
          "refId": "A"
        }
      ],
      "title": "P95 Latency",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_GRAFANACLOUD_METRICS}",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (http_response_status_class) (rate(http_server_request_count_total{deployment_environment=~\"$environment\",service_name=~\"$service\",platform_observability_runtime_mode=~\"$runtime_mode\",platform_observability_telemetry_profile=~\"$telemetry_profile\"}[5m]))",
          "legendFormat": "{{http_response_status_class}}",
          "refId": "A"
        }
      ],
      "title": "Status-Class Rate",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_GRAFANACLOUD_METRICS}",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "topk(10, sum by (http_route) (rate(http_server_request_count_total{deployment_environment=~\"$environment\",service_name=~\"$service\",platform_observability_runtime_mode=~\"$runtime_mode\",platform_observability_telemetry_profile=~\"$telemetry_profile\"}[5m])))",
          "legendFormat": "{{http_route}}",
          "refId": "A"
        }
      ],
      "title": "Top Routes by Throughput",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": [
    "phase-3",
    "p3-t06",
    "grafana-cloud",
    "api"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": [
            "$__all"
          ]
        },
        "datasource": "${DS_GRAFANACLOUD_METRICS}",
        "definition": "label_values(http_server_request_count_total, deployment_environment)",
        "includeAll": true,
        "label": "Environment",
        "multi": true,
        "name": "environment",
        "options": [],
        "query": {
          "query": "label_values(http_server_request_count_total, deployment_environment)",
          "refId": "PrometheusVariableQueryEditor-Environment"
        },
        "refresh": 1,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "backend-api",
          "value": [
            "backend-api"
          ]
        },
        "datasource": "${DS_GRAFANACLOUD_METRICS}",
        "definition": "label_values(http_server_request_count_total{deployment_environment=~\"$environment\"}, service_name)",
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "options": [],
        "query": {
          "query": "label_values(http_server_request_count_total{deployment_environment=~\"$environment\"}, service_name)",
          "refId": "PrometheusVariableQueryEditor-Service"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": [
            "$__all"
          ]
        },
        "datasource": "${DS_GRAFANACLOUD_METRICS}",
        "definition": "label_values(http_server_request_count_total{deployment_environment=~\"$environment\",service_name=~\"$service\"}, platform_observability_runtime_mode)",
        "includeAll": true,
        "label": "Runtime Mode",
        "multi": true,
        "name": "runtime_mode",
        "options": [],
        "query": {
          "query": "label_values(http_server_request_count_total{deployment_environment=~\"$environment\",service_name=~\"$service\"}, platform_observability_runtime_mode)",
          "refId": "PrometheusVariableQueryEditor-Mode"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": [
            "$__all"
          ]
        },
        "datasource": "${DS_GRAFANACLOUD_METRICS}",
        "definition": "label_values(http_server_request_count_total{deployment_environment=~\"$environment\",service_name=~\"$service\"}, platform_observability_telemetry_profile)",
        "includeAll": true,
        "label": "Telemetry Profile",
        "multi": true,
        "name": "telemetry_profile",
        "options": [],
        "query": {
          "query": "label_values(http_server_request_count_total{deployment_environment=~\"$environment\",service_name=~\"$service\"}, platform_observability_telemetry_profile)",
          "refId": "PrometheusVariableQueryEditor-Profile"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "API Golden Signals",
  "uid": "bp-api-golden-signals",
  "version": 1,
  "weekStart": ""
}
